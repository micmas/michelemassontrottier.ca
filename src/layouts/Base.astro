---
import '../styles/global.css';
import { navFr, navEn, social, ui, type Lang } from '../data/nav';
import { getAlternates } from '../lib/i18n';
import videos from '../data/videos.json';
import LegacyRedirects from '../components/LegacyRedirects.astro';

interface Props { title: string; description?: string; wide?: boolean; noindex?: boolean; lang?: Lang; notFound?: boolean }
const { title, description, wide = false, noindex = false, lang = 'fr', notFound = false } = Astro.props;
const t = ui[lang];
const nav = lang === 'en' ? navEn : navFr;
const siteName = 'Michèle Masson-Trottier';
const isHome = title === 'Accueil' || title === 'Home';
const fullTitle = isHome ? `${siteName} – ${t.titleSuffix}` : `${title} – ${siteName}`;
const desc = description ?? t.description;

// Current path without the GitHub Pages sub-path (if any)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const { frToEn, enToFr } = await getAlternates();
const frPath = lang === 'fr' ? path : enToFr[path] ?? '/';
const enPath = lang === 'en' ? path : frToEn[path] ?? '/en/';
const isCurrent = (href: string) => path === href;
const home = lang === 'en' ? '/en/' : '/';
---
<!doctype html>
<html lang={lang} data-not-found={notFound ? '1' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <script is:inline>
    // Apply the saved theme before the page paints (no flash). Default: follow the device setting.
    try { const th = localStorage.getItem('theme'); if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th; } catch (e) {}
  </script>
  <LegacyRedirects />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="alternate" hreflang="fr" href={new URL(frPath, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(frPath, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:locale" content={lang === 'en' ? 'en_CA' : 'fr_CA'} />
  <meta property="og:image" content={new URL('/media/2024/09/logo_mmt_meilleurres_999x5720_blanc.png', Astro.site)} />
</head>
<body>
  <a class="skip" href="#contenu">{t.skip}</a>
  <header class="site-header">
    <div class="inner">
      <a class="brand" href={home}>
        <img src="/media/2024/09/sanstexte_377x300.png" alt="" width="52" height="41" />
        <span>{siteName}</span>
      </a>
      <nav class="main" id="menu" aria-label={t.mainMenu}>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              {item.children && (
                <ul>
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="controls">
        <div class="lang-switch" role="group" aria-label={t.langLabel}>
          {lang === 'fr'
            ? <><span aria-current="true" lang="fr">FR</span><a href={enPath} hreflang="en" lang="en" data-lang="en" title="English">EN</a></>
            : <><a href={frPath} hreflang="fr" lang="fr" data-lang="fr" title="Français">FR</a><span aria-current="true" lang="en">EN</span></>}
        </div>
        <button class="theme-toggle" type="button" aria-label={t.themeLabel} title={t.themeLabel}>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="menu-toggle" aria-expanded="false" aria-controls="menu">{t.menu}</button>
      </div>
    </div>
  </header>

  <main id="contenu" class={wide ? 'wide' : undefined}>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="inner">
      <div>
        <a class="brand" href={home}><img src="/media/2024/09/sanstexte_377x300.png" alt="" width="90" height="72" /></a>
        <p>{siteName}<br /><small>{t.tagline}</small></p>
      </div>
      <div>
        <h2>{t.about}</h2>
        <ul>
          <li><a href={lang === 'en' ? '/en/about/' : '/a-propos/'}>{t.aboutMe}</a></li>
          <li><a href={lang === 'en' ? '/en/contact/' : '/contactez-moi/'}>{t.contact}</a></li>
          <li><a href={lang === 'en' ? '/en/privacy/' : '/confidentialite/'}>{t.privacy}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t.networks}</h2>
        <ul>{social.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}</ul>
      </div>
    </div>
  </footer>

  <script is:inline define:vars={{ videos }}>
    window.__VIDEOS = videos;
  </script>
  <script>
    import { enhance } from '../scripts/enhance';
    enhance(document);
    const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.getElementById('menu');
    btn?.addEventListener('click', () => {
      const open = menu!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    // Light / dark toggle: remembers the visitor's choice on this device
    const root = document.documentElement;
    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* private mode */ }
    });
  </script>
</body>
</html>
