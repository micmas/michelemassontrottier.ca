---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = (await getCollection('pagesEn')).filter((p) => p.id !== 'index');
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} lang="en" wide={entry.data.wide}>
  <h1 class="page-title">{entry.data.title}</h1>
  <div class="prose"><Content /></div>
</Base>
